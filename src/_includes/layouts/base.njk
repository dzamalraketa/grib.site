<!doctype html>
<html lang="{{ lang or 'ru' }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1B1712" media="(prefers-color-scheme: dark)">
    {% set siteTitle = "Mushroom World" if lang == "en" else site.title %}
    <title>{% if title %}{{ title }} — {{ siteTitle }}{% else %}{{ siteTitle }}{% endif %}</title>
    <meta name="description" content="{{ description or summary or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {# hreflang: пара RU↔EN. EN-страница живёт по URL = "/en" + русский URL. #}
    {% if lang == "en" %}
      {% set altRu = page.url | replace("/en/", "/") %}
      <link rel="alternate" hreflang="ru" href="{{ site.url }}{{ altRu }}">
      <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altRu }}">
    {% else %}
      {% set altEn = "/en" + page.url %}
      {% if collections.enUrls | listHas(altEn) %}
        <link rel="alternate" hreflang="en" href="{{ site.url }}{{ altEn }}">
        <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">
      {% endif %}
    {% endif %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} — статьи" href="{{ '/feed.xml' | url }}">

    {# Preconnect для шрифтов Google Fonts (Fraunces, Source Serif 4, Work Sans) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=Source+Serif+4:opsz,wght@8..60,300..700&family=Work+Sans:wght@400..700&display=swap">

    {# Верификация поисковых кабинетов: коды задаются в src/_data/site.json #}
    {% if site.verification.google %}<meta name="google-site-verification" content="{{ site.verification.google }}">{% endif %}
    {% if site.verification.yandex %}<meta name="yandex-verification" content="{{ site.verification.yandex }}">{% endif %}

    {# Open Graph / Twitter Card #}
    {% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">{% endif %}
    <meta property="og:type" content="{{ og_type or 'website' }}">
    <meta property="og:site_name" content="{{ siteTitle }}">
    <meta property="og:title" content="{% if title %}{{ title }} — {{ siteTitle }}{% else %}{{ siteTitle }}{% endif %}">
    <meta property="og:description" content="{{ description or summary or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% set og_image = image or site.default_image %}
    {% if og_image and og_image.indexOf("http") == 0 %}
      <meta property="og:image" content="{{ og_image }}">
    {% else %}
      <meta property="og:image" content="{{ site.url }}{{ og_image }}">
    {% endif %}
    {% if og_image and og_image.endsWith(".png") %}
      <meta property="og:image:type" content="image/png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    {% elif og_image %}
      <meta property="og:image:type" content="image/jpeg">
      <meta property="og:image:width" content="1200">
    {% endif %}
    <meta property="og:image:alt" content="{{ image_alt or title or site.title }}">
    <meta property="og:locale" content="{{ 'en_US' if lang == 'en' else 'ru_RU' }}">
    {% if og_type == "article" and date %}
    <meta property="article:published_time" content="{{ date | isoDate }}">
    <meta property="article:modified_time" content="{{ (verification_date or date) | isoDate }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }} — {{ siteTitle }}{% else %}{{ siteTitle }}{% endif %}">
    <meta name="twitter:description" content="{{ description or summary or site.description }}">
    {% if og_image and og_image.indexOf("http") == 0 %}
      <meta name="twitter:image" content="{{ og_image }}">
    {% else %}
      <meta name="twitter:image" content="{{ site.url }}{{ og_image }}">
    {% endif %}

    {% if schema %}
      <script type="application/ld+json">{{ schema | safe }}</script>
    {% endif %}

    {# BreadcrumbList: строится по первому сегменту URL (для EN — по второму).
       Служебные страницы и индексы разделов пропускаются. #}
    {% if lang == "en" %}
      {% set crumb_sections = {
        "/griby/": "Mushroom catalog",
        "/issledovaniya/": "Research",
        "/stati/": "Articles",
        "/temy/": "Topics"
      } %}
      {% set seg = "/" + page.url.split("/")[2] + "/" %}
      {% set segUrl = "/en" + seg %}
      {% set crumb_home_name = "Home" %}
      {% set crumb_home_url = "/en/" %}
    {% else %}
      {% set crumb_sections = {
        "/griby/": "Каталог грибов",
        "/issledovaniya/": "Исследования",
        "/stati/": "Статьи",
        "/temy/": "Темы"
      } %}
      {% set seg = "/" + page.url.split("/")[1] + "/" %}
      {% set segUrl = seg %}
      {% set crumb_home_name = "Главная" %}
      {% set crumb_home_url = "/" %}
    {% endif %}
    {% if page.url != "/" and page.url != "/en/" and crumb_sections[seg] and page.url != segUrl %}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ crumb_home_name | dump | safe }}, "item": {{ (site.url + crumb_home_url) | dump | safe }} },
          { "@type": "ListItem", "position": 2, "name": {{ crumb_sections[seg] | dump | safe }}, "item": {{ (site.url + segUrl) | dump | safe }} },
          { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": {{ (site.url + page.url) | dump | safe }} }
        ]
      }
      </script>
    {% endif %}

    <link rel="stylesheet" href="{{ '/assets/css/tokens.css' | url }}?v={{ site.version }}">
    <link rel="stylesheet" href="{{ '/assets/css/base.css' | url }}?v={{ site.version }}">
    <link rel="stylesheet" href="{{ '/assets/css/components.css' | url }}?v={{ site.version }}">
    <link rel="stylesheet" href="{{ '/assets/css/motion.css' | url }}?v={{ site.version }}">

    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | url }}?v={{ site.version }}">

    {# Inline-скрипт: установить тему ДО отрисовки.
       Светлая — по умолчанию. Сохранённый выбор пользователя перекрывает дефолт. #}
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          } else {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    {% set L = i18n[lang] if lang and i18n[lang] else {} %}
    <a class="skip-link" href="#main">{{ L.ui.skip if L.ui else "Перейти к содержимому" }}</a>

    {% include "partials/header.njk" %}

    <main id="main" class="container{% if wide %} container--wide{% endif %}" data-pagefind-body>
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <script src="{{ '/assets/js/theme.js' | url }}?v={{ site.version }}" defer></script>
    <script src="{{ '/assets/js/menu.js' | url }}?v={{ site.version }}" defer></script>
    <script src="{{ '/assets/js/motion.js' | url }}?v={{ site.version }}" defer></script>
    {% block pageScripts %}{% endblock %}
  </body>
</html>
