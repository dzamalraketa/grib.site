<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1B1712" media="(prefers-color-scheme: dark)">
    <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or summary or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} — статьи" href="{{ '/feed.xml' | url }}">

    {# Preconnect для шрифтов Google Fonts (Fraunces, Source Serif 4, Work Sans) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=Source+Serif+4:opsz,wght@8..60,300..700&family=Work+Sans:wght@400..700&display=swap">

    {# Open Graph / Twitter Card #}
    <meta property="og:type" content="{{ og_type or 'website' }}">
    <meta property="og:title" content="{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{{ description or summary or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% set og_image = image or site.default_image %}
    {% if og_image and og_image.indexOf("http") == 0 %}
      <meta property="og:image" content="{{ og_image }}">
    {% else %}
      <meta property="og:image" content="{{ site.url }}{{ og_image }}">
    {% endif %}
    <meta property="og:locale" content="ru_RU">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}">
    <meta name="twitter:description" content="{{ description or summary or site.description }}">
    {% if og_image and og_image.indexOf("http") == 0 %}
      <meta name="twitter:image" content="{{ og_image }}">
    {% else %}
      <meta name="twitter:image" content="{{ site.url }}{{ og_image }}">
    {% endif %}

    {% if schema %}
      <script type="application/ld+json">{{ schema | safe }}</script>
    {% endif %}

    <link rel="stylesheet" href="{{ '/assets/css/tokens.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/base.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/components.css' | url }}">

    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | url }}">

    {# Inline-скрипт: установить тему ДО отрисовки.
       Светлая — по умолчанию. Сохранённый выбор пользователя перекрывает дефолт. #}
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          } else {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>

    {% include "partials/header.njk" %}

    <main id="main" class="container" data-pagefind-body>
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <script src="{{ '/assets/js/theme.js' | url }}" defer></script>
    <script src="{{ '/assets/js/menu.js' | url }}" defer></script>
    {% block pageScripts %}{% endblock %}
  </body>
</html>
