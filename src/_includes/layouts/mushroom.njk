---
layout: layouts/base.njk
og_type: "article"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (summary or description or site.description) | dump | safe }},
  "inLanguage": "ru",
  "image": {{ (site.url + (image or site.default_image)) | dump | safe }},
  "author": {
    "@type": "Organization",
    "name": {{ site.author | dump | safe }},
    "url": {{ site.url | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | dump | safe }},
    "url": {{ site.url | dump | safe }}
  },
  "datePublished": {{ (date | isoDate) | dump | safe }},
  "dateModified": {{ ((verification_date or date) | isoDate) | dump | safe }},
  "mainEntityOfPage": {{ (site.url + page.url) | dump | safe }},
  "about": {
    "@type": "Taxon",
    "name": {{ (latin_name or title) | dump | safe }}
  }
}
</script>

<article class="mushroom-page">
  <header class="mushroom-header">
    <div class="mushroom-header__media">
      {% if image %}
        <img src="{{ image | url }}" alt="{{ image_alt or title }}" loading="eager" decoding="async">
      {% else %}
        <img src="{{ '/assets/img/fallback-illustration.svg' | url }}" alt="" aria-hidden="true">
      {% endif %}
    </div>
    <div>
      {% set stamp_status = status %}
      {% set stamp_label = status | statusLabel %}
      {% set stamp_size = "lg" %}
      {% include "partials/spore-stamp.njk" %}

      <h1 class="mushroom-header__title">{{ title }}</h1>
      {% if latin_name %}<p class="mushroom-header__latin">{{ latin_name }}</p>{% endif %}

      {% include "partials/image-caption.njk" %}

      <dl class="mushroom-meta">
        {% if habitat %}<dt>Среда</dt><dd>{{ habitat }}</dd>{% endif %}
        {% if season %}<dt>Сезон</dt><dd>{{ season }}</dd>{% endif %}
        {% if verified %}<dt>Проверено</dt><dd>{{ verification_date | ruDate or "—" }}</dd>{% endif %}
      </dl>
    </div>
  </header>

  {% set divider_opacity = 0.10 %}
  {% set divider_lines = 28 %}
  {% include "partials/gill-divider.njk" %}

  <div class="article-content">
    {{ content | safe }}
  </div>

  {# Связанные исследования: подбор карточек из /issledovaniya/,
     у которых поле mushroom содержит латинское название вида
     (или одно из значений research_match из front matter). #}
  {% set species_research = [] %}
  {% set needles = research_match or ([latin_name] if latin_name else []) %}
  {% for item in collections.issledovaniya %}
    {% for n in needles %}
      {% if item.data.mushroom and item.data.mushroom.indexOf(n) > -1 and not (item in species_research) %}
        {% set _ = species_research.push(item) %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% if species_research.length > 0 %}
    <section class="related-research" aria-label="Исследования по этому виду">
      <h2>Исследования по этому виду</h2>
      <ul class="related-research__list">
        {% for item in species_research %}
          <li>
            <a href="{{ item.url | url }}">{{ item.data.title }}</a>
            {% if item.data.year %}<span class="related-research__year">, {{ item.data.year }}</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if tags and tags.length > 0 %}
    <div class="tags" style="margin-top: var(--space-4);">
      {% for t in tags %}<span class="tag">#{{ t }}</span>{% endfor %}
    </div>
  {% endif %}

  {% include "partials/sources-block.njk" %}
</article>
