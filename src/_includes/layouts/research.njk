---
layout: layouts/base.njk
og_type: "article"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (summary or description or site.description) | dump | safe }},
  "inLanguage": {{ (lang or "ru") | dump | safe }},
  "datePublished": {{ (date | isoDate) | dump | safe }},
  "author": {
    "@type": "Organization",
    "name": {{ site.author | dump | safe }},
    "url": {{ site.url | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | dump | safe }},
    "url": {{ site.url | dump | safe }}
  },
  "mainEntityOfPage": {{ (site.url + page.url) | dump | safe }}{% if mushroom %},
  "about": {{ mushroom | dump | safe }}{% endif %}{% if source_url %},
  "citation": {
    "@type": "ScholarlyArticle",
    "url": {{ source_url | dump | safe }},
    "name": {{ (source_name or source_url) | dump | safe }}
  }{% endif %}
}
</script>

{% if lang == "en" %}
  {% set R = {
    "fullPaperAria": "Links to the full research text",
    "fullPaperTitle": "📄 Where to read the full paper",
    "originalArticle": "Original article",
    "pubmedNote": "abstract and full-text links",
    "linkN": "Link №1",
    "metaAria": "Research summary",
    "mushroom": "Species / object",
    "design": "Design",
    "date": "Date",
    "source": "Source",
    "allLinks": "All links",
    "backToCatalog": "← Back to the research catalog",
    "openOriginal": "📄 Open the original paper →",
    "catalogUrl": "/en/issledovaniya/"
  } %}
{% else %}
  {% set R = {
    "fullPaperAria": "Ссылки на полный текст исследования",
    "fullPaperTitle": "📄 Где почитать исследование целиком",
    "originalArticle": "Оригинальная статья",
    "pubmedNote": "аннотация и ссылки на полный текст",
    "linkN": "Ссылка №1",
    "metaAria": "Сводная информация об исследовании",
    "mushroom": "Гриб / объект",
    "design": "Дизайн",
    "date": "Дата",
    "source": "Источник",
    "allLinks": "Все ссылки",
    "backToCatalog": "← Вернуться к каталогу исследований",
    "openOriginal": "📄 Открыть оригинал исследования →",
    "catalogUrl": "/issledovaniya/"
  } %}
{% endif %}

<article class="research-page">
  <header class="article-header">
    <div class="article-header__meta">
      {% if date %}<time datetime="{{ date | isoDate }}">{{ date | dateFmt(lang) }}</time>{% endif %}
      {% if category_label %}
        <span aria-hidden="true">·</span>
        <span class="card--research__cat" style="--cat-color: {% for c in categories.research %}{% if c.id == category %}{{ c.color }}{% endif %}{% endfor %};">
          <span class="card--research__cat-dot" aria-hidden="true"></span>
          <span class="card--research__cat-label">{{ category_label }}</span>
        </span>
      {% endif %}
      {% if year %}<span aria-hidden="true">·</span><span>{{ year }}{{ "" if lang == "en" else " г." }}</span>{% endif %}
    </div>
    <h1 class="article-header__title">{{ title }}</h1>
    {% if summary %}<p class="article-header__summary">{{ summary }}</p>{% endif %}

    <div class="full-paper-callout" role="note" aria-label="{{ R.fullPaperAria }}">
      <p class="full-paper-callout__title">{{ R.fullPaperTitle }}</p>
      <ul class="full-paper-callout__list">
        {% if source_url %}
          <li>
            <a href="{{ source_url }}" rel="noopener noreferrer" target="_blank">
              <strong>{{ R.originalArticle }}</strong> — {{ source_name }}
            </a>
          </li>
        {% endif %}
        {% if sources and sources.length > 0 %}
          {% for src in sources %}
            {% if src.url and src.url.indexOf("pubmed") > -1 %}
              <li>
                <a href="{{ src.url }}" rel="noopener noreferrer" target="_blank">
                  <strong>PubMed</strong> — {{ R.pubmedNote }}
                </a>
              </li>
            {% elif src.url and src.url.indexOf("doi") > -1 %}
              <li>
                <a href="{{ src.url }}" rel="noopener noreferrer" target="_blank">
                  <strong>DOI</strong> — {{ src.title | truncate(60, true, "…") }}
                </a>
              </li>
            {% elif src.url and loop.index == 1 %}
              <li>
                <a href="{{ src.url }}" rel="noopener noreferrer" target="_blank">
                  <strong>{{ R.linkN }}</strong> — {{ src.title | truncate(60, true, "…") }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </header>

  {% set divider_opacity = 0.10 %}
  {% set divider_lines = 28 %}
  {% include "partials/gill-divider.njk" %}

  <div class="research-page__grid">
    <aside class="research-meta" aria-label="{{ R.metaAria }}">
      <dl>
        {% if mushroom %}<dt>{{ R.mushroom }}</dt><dd>{{ mushroom }}</dd>{% endif %}
        {% if design %}<dt>{{ R.design }}</dt><dd>{{ design }}</dd>{% endif %}
        {% if date %}<dt>{{ R.date }}</dt><dd><time datetime="{{ date | isoDate }}">{{ date | dateFmt(lang) }}{% if lang != "en" %}, {{ year }} г.{% endif %}</time></dd>{% endif %}
        <dt>{{ R.source }}</dt>
        <dd>
          <a href="{{ source_url }}" rel="noopener noreferrer" target="_blank">{{ source_name }}</a>
        </dd>
        {% if sources and sources.length > 0 %}
          <dt>{{ R.allLinks }}</dt>
          <dd>
            <ol class="research-meta__sources">
              {% for src in sources %}
                <li>
                  {% if src.url %}<a href="{{ src.url }}" rel="noopener noreferrer" target="_blank">{{ src.title | truncate(70, true, "…") }}</a>{% else %}{{ src.title | truncate(70, true, "…") }}{% endif %}
                </li>
              {% endfor %}
            </ol>
          </dd>
        {% endif %}
      </dl>
    </aside>

    <div class="research-page__body">
      <div class="article-content">
        {{ content | safe }}
      </div>
    </div>
  </div>

  {% include "partials/sources-block.njk" %}

  <div class="research-page__cta">
    <a class="btn" href="{{ R.catalogUrl | url }}">{{ R.backToCatalog }}</a>
    <a class="btn btn--primary" href="{{ source_url }}" rel="noopener noreferrer" target="_blank">{{ R.openOriginal }}</a>
  </div>
</article>
