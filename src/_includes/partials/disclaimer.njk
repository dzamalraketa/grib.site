{# disclaimer.njk — выводит блок-предупреждение.
   Параметр: disclaimer_type ("foraging" | "health" | "psilocybin").
   Перед include нужно установить: {% set disclaimer_type = "..." %} #}

{% if disclaimer_type == "foraging" %}
  <aside class="disclaimer" role="note" aria-label="Предупреждение о сборе грибов">
    <p class="disclaimer__title">Важно</p>
    <p>Материалы носят информационный характер и не являются руководством для самостоятельного сбора грибов. Ошибка при определении вида может привести к серьёзному отравлению. Перед сбором и употреблением дикорастущих грибов проконсультируйтесь со специалистом-микологом.</p>
  </aside>
{% elif disclaimer_type == "health" %}
  <aside class="disclaimer" role="note" aria-label="Предупреждение о медицинских рекомендациях">
    <p class="disclaimer__title">Медицинский дисклеймер</p>
    <p>Информация носит ознакомительный характер и не является медицинской рекомендацией. Не используйте материалы сайта как основание для самолечения — обратитесь к врачу.</p>
  </aside>
{% elif disclaimer_type == "psilocybin" %}
  <aside class="disclaimer" role="note" aria-label="Предупреждение о психоактивных веществах">
    <p class="disclaimer__title">Правовой дисклеймер</p>
    <p>Раздел содержит обзор научных публикаций и клинических исследований. Псилоцибин и содержащие его грибы отнесены к контролируемым веществам в России и ряде других стран. Материалы не являются призывом к употреблению и не содержат инструкций по применению.</p>
  </aside>
{% endif %}
