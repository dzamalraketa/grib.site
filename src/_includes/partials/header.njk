<header class="site-header" role="banner" data-site-header>
  <div class="container site-header__inner">
    <a class="site-brand" href="{{ '/' | url }}" aria-label="{{ site.title }} — главная">
      <svg class="site-brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M5 15 C5 9 10 5 16 5 C22 5 27 9 27 15 C27 16.5 26 17.5 25 18 L24 18.5 C23 19 22 19.5 21 19.5 L11 19.5 C10 19.5 9 19 8 18.5 L7 18 C6 17.5 5 16.5 5 15 Z"
              fill="currentColor"/>
        <path d="M13.5 19.5 L13.5 25 C13.5 26 14.5 27 16 27 C17.5 27 18.5 26 18.5 25 L18.5 19.5 Z"
              fill="var(--color-clay, #C97B4A)"/>
        <path d="M16 27 L16 30" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        <path d="M12 28.5 L10 30.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        <path d="M20 28.5 L22 30.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        <circle cx="22" cy="9" r="1.4" fill="#FAF8F3" opacity="0.55"/>
      </svg>
      <span class="site-brand__text">{{ site.title }}</span>
    </a>

    <nav class="site-nav site-nav--primary" aria-label="Основная навигация">
      {% for item in site.navigation.primary %}
        {% set is_current = page.url == item.url or (item.url != "/" and page.url and page.url.startsWith(item.url)) %}
        <a class="site-nav__link" href="{{ item.url | url }}" {% if is_current %}aria-current="page"{% endif %}>{{ item.text }}</a>
      {% endfor %}
    </nav>

    <div class="site-header__actions">
      <button type="button" class="icon-btn" data-search-toggle aria-label="Поиск по сайту" aria-expanded="false" aria-controls="site-search">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-3.5-3.5"/>
        </svg>
      </button>

      <button type="button" class="icon-btn" data-theme-toggle aria-label="Включить тёмную тему">
        <svg class="icon-btn__icon icon-btn__icon--sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-btn__icon icon-btn__icon--moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button type="button" class="icon-btn site-menu-toggle" data-menu-toggle aria-label="Открыть меню" aria-expanded="false" aria-controls="site-menu">
        <svg class="site-menu-toggle__icon site-menu-toggle__icon--open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg class="site-menu-toggle__icon site-menu-toggle__icon--close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
  </div>

  {# Выпадающая панель поиска (открывается по клику на лупу) #}
  <div class="site-search" id="site-search" data-site-search hidden>
    <div class="container site-search__inner">
      <form class="site-search__form" role="search" action="{{ '/poisk/' | url }}" method="get">
        <label for="site-search-input" class="visually-hidden">Поиск по сайту</label>
        <input type="search" id="site-search-input" name="q" placeholder="Поиск по сайту — виды, темы, статьи…" autocomplete="off" data-site-search-input>
        <button type="submit" class="btn btn--primary site-search__submit">Найти</button>
        <button type="button" class="icon-btn site-search__close" data-search-close aria-label="Закрыть поиск">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
      </form>
      <p class="site-search__hint">
        <a href="{{ '/poisk/' | url }}">Расширенный поиск →</a>
      </p>
    </div>
  </div>
</header>

{# Мобильный drawer с навигацией (slide-in) #}
<aside class="site-menu" id="site-menu" data-site-menu hidden aria-label="Мобильная навигация">
  <div class="site-menu__panel">
    <nav class="site-menu__nav" aria-label="Разделы сайта">
      {% for item in site.navigation.primary %}
        {% set is_current = page.url == item.url or (item.url != "/" and page.url and page.url.startsWith(item.url)) %}
        <a class="site-menu__link" href="{{ item.url | url }}" {% if is_current %}aria-current="page"{% endif %}>{{ item.text }}</a>
      {% endfor %}
    </nav>
    <div class="site-menu__divider" aria-hidden="true"></div>
    <nav class="site-menu__subnav" aria-label="Дополнительно">
      {% for item in site.navigation.footer %}
        <a class="site-menu__sublink" href="{{ item.url | url }}">{{ item.text }}</a>
      {% endfor %}
    </nav>
    <div class="site-menu__divider" aria-hidden="true"></div>
    <div class="site-menu__footer">
      <a class="site-menu__contact" href="{{ '/kontakty/' | url }}">Связаться с командой</a>
    </div>
  </div>
  <button type="button" class="site-menu__scrim" data-menu-close aria-label="Закрыть меню" tabindex="-1"></button>
</aside>
