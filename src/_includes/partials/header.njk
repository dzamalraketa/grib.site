<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a class="site-brand" href="{{ '/' | url }}" aria-label="{{ site.title }} — главная">
      <svg class="site-brand__mark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2c4 0 7 3 7 7 0 2-1 3-2 4l-1 1c-1 1-2 2-4 2s-3-1-4-2l-1-1c-1-1-2-2-2-4 0-4 3-7 7-7z"></path>
        <path d="M12 16v6"></path>
        <path d="M9 22h6"></path>
      </svg>
      <span>{{ site.title }}</span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      {% for item in site.navigation.primary %}
        {% set is_current = page.url == item.url or (item.url != "/" and page.url and page.url.startsWith(item.url)) %}
        <a class="site-nav__link" href="{{ item.url | url }}" {% if is_current %}aria-current="page"{% endif %}>{{ item.text }}</a>
      {% endfor %}

      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Переключить тему">
        <span aria-hidden="true">◐</span>
        <span data-theme-toggle-label>Тёмная</span>
      </button>
    </nav>
  </div>
</header>
