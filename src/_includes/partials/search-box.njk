{# search-box.njk — контейнер поиска на базе Pagefind Component API.
   Pagefind собирается командой `npm run build` (pagefind --site _site).
   Начиная с Pagefind 1.5 для интеграции рекомендуется Component UI
   (web components), а старый `pagefind-ui.js` больше не генерируется.
   Если индекс не собран, показывается понятное сообщение. #}

<div class="search-block" data-pagefind-root>
  <h2>Поиск по сайту</h2>
  <p class="search-block__hint">
    Введите слово или фразу — например, «лисичка», «микориза», «агарикон».
  </p>

  {# Сюда монтируется Pagefind Component UI. Если скрипт не загрузится
     (индекс не собран), покажется fallback-блок. #}
  <div id="search" data-pagefind-mount class="pagefind-mount">
    <pagefind-search class="pagefind-search">
      <form slot="search-input" class="pagefind-form" role="search">
        <label for="pagefind-search-input" class="visually-hidden">Поиск по сайту</label>
        <pagefind-input>
          <input id="pagefind-search-input" name="query" type="search"
                 placeholder="Поиск по сайту…"
                 autocomplete="off" enterkeyhint="search">
        </pagefind-input>
        <button type="submit" class="btn btn--primary pagefind-form__submit">Найти</button>
      </form>
      <div slot="summary" aria-live="polite">
        <pagefind-summary class="pagefind-summary"></pagefind-summary>
      </div>
      <div slot="results">
        <pagefind-results class="pagefind-results"></pagefind-results>
      </div>
    </pagefind-search>
  </div>

  <noscript>
    <p class="empty">Для поиска требуется JavaScript.</p>
  </noscript>

  <p class="search-block__fallback" data-pagefind-fallback hidden>
    Поисковый индекс ещё не построен. Запустите
    <code>npm run build</code> локально, чтобы Pagefind проиндексировал
    страницы, или откройте уже собранную версию сайта.
  </p>
</div>

<link rel="stylesheet" href="{{ '/pagefind/pagefind-component-ui.css' | url }}?v={{ site.version }}">
<script src="{{ '/pagefind/pagefind-component-ui.js' | url }}?v={{ site.version }}" defer></script>

<script>
  (function () {
    "use strict";

    function showFallback() {
      var mount = document.querySelector("[data-pagefind-mount]");
      if (mount) mount.style.display = "none";
      var fb = document.querySelector("[data-pagefind-fallback]");
      if (fb) fb.hidden = false;
    }

    function checkReady() {
      // Проверяем наличие скрипта компонента
      var scripts = document.querySelectorAll('script[src*="pagefind-component-ui.js"]');
      if (scripts.length === 0) {
        showFallback();
        return;
      }
      // Pagefind в 1.5 регистрирует customElement <pagefind-search>
      // после загрузки скрипта. Если через секунду ничего не зарегистрировано
      // и нет индекса — показываем fallback.
      setTimeout(function () {
        if (!customElements || !customElements.get("pagefind-search")) {
          showFallback();
        }
      }, 1500);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", checkReady);
    } else {
      checkReady();
    }
  })();
</script>
