{# sources-block.njk — список источников из front matter.
   Ожидает, что у страницы есть sources: [{ title, url }, ...] #}

{% if sources and sources.length > 0 %}
  {% set L = i18n[lang] if lang and i18n[lang] else {} %}
  <section class="sources" aria-label="{{ L.ui.sources if L.ui else 'Источники' }}">
    <h2 class="sources__title">{{ L.ui.sources if L.ui else "Источники" }}</h2>
    <ol class="sources__list">
      {% for src in sources %}
        <li>
          {% if src.url %}<a href="{{ src.url }}" rel="noopener noreferrer" target="_blank">{{ src.title }}</a>{% else %}{{ src.title }}{% endif %}
        </li>
      {% endfor %}
    </ol>
  </section>
{% endif %}
