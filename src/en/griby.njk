---
wide: true
layout: layouts/base.njk
title: "Mushroom catalog"
description: "Mushroom species cards: description, habitat, edibility status and sources."
permalink: "/en/griby/"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "inLanguage": "en",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collections.gribyEn.length }},
    "itemListElement": [
      {%- for g in collections.gribyEn %}
      { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ g.data.title | dump | safe }}, "url": {{ (site.url + g.url) | dump | safe }} }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
}
</script>

<header class="page-header">
  <p class="page-header__eyebrow">Section</p>
  <h1 class="page-header__title">Mushroom catalog</h1>
  <p class="page-header__lead">
    Edible, conditionally edible, poisonous and medicinal species:
    description, habitat, season and sources. Filter by edibility, by
    where the mushroom grows (on wood, with trees, in meadows), and by
    notable features.
  </p>
</header>

<section class="catalog-filters" aria-label="Catalog filters">
  <div class="filter-group">
    <p class="filter-group__title" id="fg-status">Edibility</p>
    <div class="filters" role="group" aria-labelledby="fg-status" data-filter-group="status">
      <button type="button" class="filter-btn" data-value="all" aria-pressed="true">All <span class="filter-btn__count" data-count="all"></span></button>
      <button type="button" class="filter-btn" data-value="edible" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--edible"></span>Edible <span class="filter-btn__count" data-count="edible"></span></button>
      <button type="button" class="filter-btn" data-value="conditional" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--conditional"></span>Conditionally edible <span class="filter-btn__count" data-count="conditional"></span></button>
      <button type="button" class="filter-btn" data-value="poisonous" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--poisonous"></span>Poisonous <span class="filter-btn__count" data-count="poisonous"></span></button>
      <button type="button" class="filter-btn" data-value="medicinal" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--medicinal"></span>Medicinal <span class="filter-btn__count" data-count="medicinal"></span></button>
    </div>
  </div>

  <div class="filter-group">
    <p class="filter-group__title" id="fg-ecology">Where it grows</p>
    <div class="filters" role="group" aria-labelledby="fg-ecology" data-filter-group="ecology">
      <button type="button" class="filter-btn" data-value="all" aria-pressed="true">All <span class="filter-btn__count" data-count="all"></span></button>
      <button type="button" class="filter-btn" data-value="wood" aria-pressed="false">Wood-decay <span class="filter-btn__count" data-count="wood"></span></button>
      <button type="button" class="filter-btn" data-value="mycorrhiza" aria-pressed="false">With trees (mycorrhiza) <span class="filter-btn__count" data-count="mycorrhiza"></span></button>
      <button type="button" class="filter-btn" data-value="soil" aria-pressed="false">Soil and meadows <span class="filter-btn__count" data-count="soil"></span></button>
      <button type="button" class="filter-btn" data-value="insect" aria-pressed="false">On insects <span class="filter-btn__count" data-count="insect"></span></button>
      <button type="button" class="filter-btn" data-value="underground" aria-pressed="false">Underground <span class="filter-btn__count" data-count="underground"></span></button>
    </div>
  </div>

  <div class="filter-group">
    <p class="filter-group__title" id="fg-feature">Features</p>
    <div class="filters" role="group" aria-labelledby="fg-feature" data-filter-group="feature">
      <button type="button" class="filter-btn" data-value="all" aria-pressed="true">All <span class="filter-btn__count" data-count="all"></span></button>
      <button type="button" class="filter-btn" data-value="gourmet" aria-pressed="false">Gourmet <span class="filter-btn__count" data-count="gourmet"></span></button>
      <button type="button" class="filter-btn" data-value="cultivated" aria-pressed="false">Cultivated <span class="filter-btn__count" data-count="cultivated"></span></button>
      <button type="button" class="filter-btn" data-value="pickling" aria-pressed="false">For pickling <span class="filter-btn__count" data-count="pickling"></span></button>
      <button type="button" class="filter-btn" data-value="spring" aria-pressed="false">Spring <span class="filter-btn__count" data-count="spring"></span></button>
      <button type="button" class="filter-btn" data-value="deadly" aria-pressed="false">Deadly <span class="filter-btn__count" data-count="deadly"></span></button>
      <button type="button" class="filter-btn" data-value="lookalike" aria-pressed="false">Dangerous lookalikes <span class="filter-btn__count" data-count="lookalike"></span></button>
    </div>
  </div>

  <p class="catalog-status" id="catalog-status" role="status" aria-live="polite"></p>
  <button type="button" class="filter-reset" id="filter-reset" hidden>Reset filters</button>
</section>

<section id="catalog" class="card-grid" aria-live="polite">
  {% for item in collections.gribyEn %}
    <article class="card card--mushroom" data-status="{{ item.data.status }}" data-ecology="{{ item.data.ecology }}" data-features="{{ item.data.tags | join('|') }}">
      <a class="card__media" href="{{ item.url | url }}" aria-hidden="true" tabindex="-1">
        {% if item.data.image %}
          <img src="{{ item.data.image | url }}" alt="" loading="lazy" decoding="async">
        {% else %}
          <img src="{{ '/assets/img/fallback-illustration.svg' | url }}" alt="" aria-hidden="true" loading="lazy">
        {% endif %}
      </a>
      {% set stamp_status = item.data.status %}
      {% set stamp_label = item.data.status | statusLabel("en") %}
      {% include "partials/spore-stamp.njk" %}
      <h3 class="card__title">
        <a href="{{ item.url | url }}" style="text-decoration: none; color: inherit;">{{ item.data.title }}</a>
      </h3>
      <p class="card__latin">{{ item.data.latin_name }}</p>
      <p class="card__summary">{{ item.data.summary or "" }}</p>
    </article>
  {% endfor %}
</section>

<script src="{{ '/assets/js/filters.js' | url }}?v={{ site.version }}" defer></script>
