---
wide: true
layout: layouts/base.njk
title: "Каталог грибов"
description: "Карточки видов грибов: описание, среда обитания, статус съедобности и источники."
permalink: "/griby/"
eleventyExcludeFromCollections: true
---

<header class="page-header">
  <p class="page-header__eyebrow">Раздел</p>
  <h1 class="page-header__title">Каталог грибов</h1>
  <p class="page-header__lead">
    Съедобные, условно-съедобные, ядовитые и лечебные виды: описание,
    среда обитания, сезон и источники. Выбирайте по съедобности, по тому,
    где растёт гриб (на дереве, с деревьями, на лугу), и по особенностям.
  </p>
</header>

<section class="catalog-filters" aria-label="Фильтры каталога">
  <div class="filter-group">
    <p class="filter-group__title" id="fg-status">Съедобность</p>
    <div class="filters" role="group" aria-labelledby="fg-status" data-filter-group="status">
      <button type="button" class="filter-btn" data-value="all" aria-pressed="true">Все <span class="filter-btn__count" data-count="all"></span></button>
      <button type="button" class="filter-btn" data-value="edible" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--edible"></span>Съедобные <span class="filter-btn__count" data-count="edible"></span></button>
      <button type="button" class="filter-btn" data-value="conditional" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--conditional"></span>Условно-съедобные <span class="filter-btn__count" data-count="conditional"></span></button>
      <button type="button" class="filter-btn" data-value="poisonous" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--poisonous"></span>Ядовитые <span class="filter-btn__count" data-count="poisonous"></span></button>
      <button type="button" class="filter-btn" data-value="medicinal" aria-pressed="false"><span class="filter-btn__stamp filter-btn__stamp--medicinal"></span>Лечебные <span class="filter-btn__count" data-count="medicinal"></span></button>
    </div>
  </div>

  <div class="filter-group">
    <p class="filter-group__title" id="fg-ecology">Где растёт</p>
    <div class="filters" role="group" aria-labelledby="fg-ecology" data-filter-group="ecology">
      <button type="button" class="filter-btn" data-value="all" aria-pressed="true">Все <span class="filter-btn__count" data-count="all"></span></button>
      <button type="button" class="filter-btn" data-value="wood" aria-pressed="false">Древесные <span class="filter-btn__count" data-count="wood"></span></button>
      <button type="button" class="filter-btn" data-value="mycorrhiza" aria-pressed="false">С деревьями (микориза) <span class="filter-btn__count" data-count="mycorrhiza"></span></button>
      <button type="button" class="filter-btn" data-value="soil" aria-pressed="false">Почвенные и луговые <span class="filter-btn__count" data-count="soil"></span></button>
      <button type="button" class="filter-btn" data-value="insect" aria-pressed="false">На насекомых <span class="filter-btn__count" data-count="insect"></span></button>
      <button type="button" class="filter-btn" data-value="underground" aria-pressed="false">Подземные <span class="filter-btn__count" data-count="underground"></span></button>
    </div>
  </div>

  <div class="filter-group">
    <p class="filter-group__title" id="fg-feature">Особенности</p>
    <div class="filters" role="group" aria-labelledby="fg-feature" data-filter-group="feature">
      <button type="button" class="filter-btn" data-value="all" aria-pressed="true">Все <span class="filter-btn__count" data-count="all"></span></button>
      <button type="button" class="filter-btn" data-value="деликатесные" aria-pressed="false">Деликатесные <span class="filter-btn__count" data-count="деликатесные"></span></button>
      <button type="button" class="filter-btn" data-value="культивируемые" aria-pressed="false">Выращивают <span class="filter-btn__count" data-count="культивируемые"></span></button>
      <button type="button" class="filter-btn" data-value="солёные" aria-pressed="false">Для засолки <span class="filter-btn__count" data-count="солёные"></span></button>
      <button type="button" class="filter-btn" data-value="весенние" aria-pressed="false">Весенние <span class="filter-btn__count" data-count="весенние"></span></button>
      <button type="button" class="filter-btn" data-value="смертельно опасные" aria-pressed="false">Смертельно опасные <span class="filter-btn__count" data-count="смертельно опасные"></span></button>
      <button type="button" class="filter-btn" data-value="двойник" aria-pressed="false">Опасные двойники <span class="filter-btn__count" data-count="двойник"></span></button>
    </div>
  </div>

  <p class="catalog-status" id="catalog-status" role="status" aria-live="polite"></p>
  <button type="button" class="filter-reset" id="filter-reset" hidden>Сбросить фильтры</button>
</section>

<section id="catalog" class="card-grid" aria-live="polite">
  {% for item in collections.griby %}
    <article class="card card--mushroom" data-status="{{ item.data.status }}" data-ecology="{{ item.data.ecology }}" data-features="{{ item.data.tags | join('|') }}">
      <a class="card__media" href="{{ item.url | url }}" aria-hidden="true" tabindex="-1">
        {% if item.data.image %}
          <img src="{{ item.data.image | url }}" alt="" loading="lazy" decoding="async">
        {% else %}
          <img src="{{ '/assets/img/fallback-illustration.svg' | url }}" alt="" aria-hidden="true">
        {% endif %}
      </a>
      {% set stamp_status = item.data.status %}
      {% set stamp_label = item.data.status | statusLabel %}
      {% include "partials/spore-stamp.njk" %}
      <h3 class="card__title">
        <a href="{{ item.url | url }}" style="text-decoration: none; color: inherit;">{{ item.data.title }}</a>
      </h3>
      <p class="card__latin">{{ item.data.latin_name }}</p>
      <p class="card__summary">{{ item.data.summary or "" }}</p>
    </article>
  {% endfor %}
</section>

<script src="{{ '/assets/js/filters.js' | url }}?v={{ site.version }}" defer></script>
