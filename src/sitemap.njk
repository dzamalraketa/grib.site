---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- set pages = collections.all | sort("url") -%}
  {%- for page in pages -%}
    {%- if page.url and not page.data.eleventyExcludeFromCollections and not page.data.draft -%}
      {%- set absUrl %}{{ site.url }}{{ page.url }}{% endset -%}
      <url>
        <loc>{{ absUrl }}</loc>
        <lastmod>{{ page.inputPath | fileModified | isoDate }}</lastmod>
        <changefreq>{% if page.url == "/" %}daily{% else %}monthly{% endif %}</changefreq>
        <priority>{% if page.url == "/" %}1.0{% elif page.url == "/o-proekte/" %}0.8{% else %}0.7{% endif %}</priority>
      </url>
    {%- endif -%}
  {%- endfor %}
  {# Главная страница исключена из коллекций, но должна быть в sitemap. #}
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ "./src/index.njk" | fileModified | isoDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  {# Разделы-индексы исключены из коллекций, но должны быть в sitemap. #}
  {%- set indexPages = [
    { url: "/griby/", src: "./src/griby.njk" },
    { url: "/sezon/", src: "./src/sezon.njk" },
    { url: "/temy/", src: "./src/temy.njk" },
    { url: "/stati/", src: "./src/stati.njk" },
    { url: "/issledovaniya/", src: "./src/issledovaniya.njk" }
  ] -%}
  {%- for ip in indexPages %}
  <url>
    <loc>{{ site.url }}{{ ip.url }}</loc>
    <lastmod>{{ ip.src | fileModified | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {%- endfor %}
</urlset>
